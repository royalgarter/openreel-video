# PostHog Analytics (optional)
# Get your keys at https://posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# Browser editor AI agent defaults (optional)
# NOTE: VITE_ vars are bundled into client code. Only put an API key here for local/private builds.
# In dev, requests to VITE_AI_BASE_URL go through a Vite proxy (/__ai-proxy), so gateways without CORS headers work.
# Provider: openai | anthropic | compatible
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
# Defaults per provider: openai https://api.openai.com/v1, anthropic https://api.anthropic.com/v1, compatible http://localhost:1234/v1
VITE_AI_BASE_URL=
VITE_AI_MODEL=
# Same-origin path used to reach VITE_AI_BASE_URL when the gateway sends no CORS headers.
# Dev and `vite preview` handle it automatically (default /__ai-proxy). For a hosted build, set it
# before building AND reverse-proxy it on your host, e.g. nginx:
#   location /__ai-proxy/ { proxy_pass https://your-gateway-host/; proxy_ssl_server_name on; proxy_set_header Host your-gateway-host; }
VITE_AI_PROXY_PATH=

# ElevenLabs text-to-speech key (optional, bundled into client code - private builds only)
VITE_ELEVENLABS_API_KEY=
